---
// HowItWorks.astro - Passo a passo idêntico ao cantinhodigital
const steps = [
  {
    step: "1",
    icon: "🎯",
    title: "Escolha seu Plano",
    desc: "Selecione o período ideal para sua necessidade: mensal, trimestral, semestral ou anual.",
    color: "from-cyan-500 to-blue-500"
  },
  {
    step: "2",
    icon: "💬",
    title: "Fale no WhatsApp",
    desc: "Nosso atendimento humano envia os dados de acesso e o tutorial passo a passo na hora.",
    color: "from-pink-500 to-purple-500"
  },
  {
    step: "3",
    icon: "🎉",
    title: "Comece a Assistir",
    desc: "Instale em até 3 telas simultâneas e aproveite canais, filmes, séries e futebol em 4K!",
    color: "from-yellow-500 to-orange-500"
  }
];
---

<section id="como-funciona" class="py-20 px-4 sm:px-6 bg-gradient-to-br from-slate-950 via-purple-950 to-pink-950">
  <div class="container mx-auto max-w-6xl">
    <h2 class="text-3xl sm:text-5xl md:text-6xl font-black text-center mb-12 sm:mb-16 tracking-tight">
      <span class="bg-gradient-to-r from-cyan-400 via-pink-500 to-yellow-400 bg-clip-text text-transparent">
        Como Funciona?
      </span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-12">
      {steps.map((item) => (
        <div class="text-center group">
          <div class={`relative w-28 h-28 sm:w-32 sm:h-32 bg-gradient-to-br ${item.color} rounded-full flex items-center justify-center text-5xl sm:text-6xl mx-auto mb-6 sm:mb-8 shadow-2xl group-hover:scale-110 transition-all duration-300`}>
            <div class="absolute -inset-2 bg-gradient-to-r from-pink-500 to-cyan-500 rounded-full blur-xl opacity-50 group-hover:opacity-100 transition duration-300 pointer-events-none"></div>
            <div class="relative z-10">{item.icon}</div>
          </div>

          <div class={`inline-block bg-gradient-to-r ${item.color} text-white text-lg sm:text-2xl font-black px-6 py-2 rounded-full mb-4 shadow-lg`}>
            PASSO {item.step}
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
            {item.title}
          </h3>

          <p class="text-gray-300 text-base sm:text-lg leading-relaxed max-w-sm mx-auto">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
