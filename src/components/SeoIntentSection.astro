---
// SeoIntentSection.astro - Seção de intenção de busca idêntica ao cantinhodigital
import { SITE_CONFIG } from '../config/site';

const wa3ScreensLink = `https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent('Quero um plano IPTV 3 telas simultâneas. Vim do Google.')}`;

const checklistItems = [
  "Teste IPTV 3 telas pelo WhatsApp",
  "3 telas ao mesmo tempo no mesmo plano",
  "Canais ao vivo, futebol, filmes e séries",
  "Compatível com Smart TV, TV Box e Fire TV",
  "Suporte humano para ativar seu acesso"
];
---

<section class="py-16 px-4 sm:px-6 bg-black border-y border-pink-500/20">
  <div class="container mx-auto max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 items-center">
      <!-- Coluna de Texto & Benefícios -->
      <div>
        <span class="inline-block bg-pink-500/15 border border-pink-500/40 text-pink-300 px-5 py-2 rounded-full font-black uppercase tracking-widest text-xs sm:text-sm mb-5">
          IPTV 3 Telas Simultâneas
        </span>

        <h2 class="text-3xl sm:text-5xl md:text-6xl font-black text-white leading-tight mb-6 tracking-tight">
          Plano IPTV 3 telas para a casa toda assistir ao mesmo tempo
        </h2>

        <p class="text-lg sm:text-xl text-gray-300 leading-relaxed mb-6 font-medium">
          Procurando IPTV 3 telas simultâneas? No <strong>Assista TV</strong> você assiste na Smart TV, no celular e no tablet sem precisar escolher quem vai usar primeiro. Ideal para família, casal ou quem quer dividir o acesso em mais aparelhos na mesma residência.
        </p>

        <p class="text-base sm:text-lg text-gray-400 leading-relaxed mb-8">
          Seja para futebol ao vivo, novelas, filmes lançamentos ou desenhos para as crianças, você tem estabilidade total com servidores redundantes e qualidade Full HD / 4K com suporte humano via WhatsApp.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {checklistItems.map((item) => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-white font-bold flex items-start gap-3">
              <span class="text-green-400 text-lg flex-shrink-0">✓</span>
              <span class="text-sm sm:text-base">{item}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Card Lateral Destacado -->
      <div class="bg-gradient-to-br from-pink-900/40 via-purple-900/40 to-cyan-900/30 border-2 border-pink-500/40 rounded-3xl p-6 sm:p-8 shadow-2xl shadow-pink-500/20 text-center">
        <div class="text-5xl sm:text-6xl mb-4">📺</div>
        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">3 telas liberadas</h3>
        <p class="text-gray-300 text-base sm:text-lg mb-6 leading-relaxed">
          TV da sala, celular e tablet conectados ao mesmo tempo, com qualidade HD/4K e conteúdo completo para toda a família.
        </p>
        <a
          href={wa3ScreensLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block w-full bg-gradient-to-r from-pink-600 to-purple-600 px-6 sm:px-8 py-4 rounded-2xl font-black text-lg sm:text-xl text-white hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-xl shadow-pink-500/40"
        >
          Quero IPTV 3 Telas 🚀
        </a>
      </div>
    </div>
  </div>
</section>
