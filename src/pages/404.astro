---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config/site';

const title = `Página Não Encontrada (404) | ${SITE_CONFIG.name}`;
const description = `A página solicitada não foi encontrada. Conheça nossos planos de IPTV Premium 3 telas.`;
---

<Layout title={title} description={description}>
  <section class="py-24 sm:py-36 px-4 sm:px-6 bg-gradient-to-br from-slate-950 via-purple-950 to-slate-950 text-center flex items-center justify-center min-h-[70vh]">
    <div class="max-w-xl mx-auto">
      <div class="text-7xl sm:text-9xl font-black bg-gradient-to-r from-cyan-400 via-pink-500 to-yellow-400 bg-clip-text text-transparent mb-4">
        404
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-white mb-4">
        Página Não Encontrada
      </h1>
      <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
        O endereço digitado não existe ou mudou de lugar. Mas os melhores canais e filmes continuam disponíveis para você!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="bg-gradient-to-r from-pink-600 to-purple-600 px-8 py-4 rounded-2xl text-white font-black text-lg hover:scale-105 transition-all shadow-xl shadow-pink-500/40"
        >
          Voltar ao Início 🚀
        </a>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent('Olá! Preciso de ajuda no assistatv.com.br')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/10 border border-white/20 px-8 py-4 rounded-2xl text-white font-bold text-lg hover:bg-white/20 transition-all"
        >
          Falar no Suporte 💬
        </a>
      </div>
    </div>
  </section>
</Layout>

