---
// src/pages/index.astro - Página Principal do Assista TV com design neon cantinhodigital
import Layout from '../layouts/Layout.astro';
import PromoCountdown from '../components/PromoCountdown.astro';
import HeroSection from '../components/HeroSection.astro';
import SeoIntentSection from '../components/SeoIntentSection.astro';
import FeatureCards from '../components/FeatureCards.astro';
import PricingSection from '../components/PricingSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE_CONFIG } from '../config/site';

const title = `${SITE_CONFIG.name} | ${SITE_CONFIG.tagline}`;
const description = SITE_CONFIG.description;
---

<Layout title={title} description={description}>
  <!-- Banner Promocional com Contador Regressivo de 6h -->
  <PromoCountdown />

  <!-- Hero com Imagem de Dispositivos e Cores Neon -->
  <HeroSection />

  <!-- Seção de Intenção SEO 3 Telas Simultâneas -->
  <SeoIntentSection />

  <!-- Cartões de Diferenciais -->
  <FeatureCards />

  <!-- Tabela de Preços e Ofertas -->
  <PricingSection />

  <!-- Depoimentos dos Clientes -->
  <TestimonialsSection />

  <!-- Como Funciona em 3 Passos -->
  <HowItWorks />

  <!-- FAQ Perguntas Frequentes -->
  <FaqSection />
</Layout>
